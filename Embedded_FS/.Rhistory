coef_parser = function(list_of_results) {
all_model_list = sapply(list_of_results, function(x) x['global_opt_models'])
save_index = 0
for (single_dab_models in all_model_list) {
sorted_model_list = list()
# This is true whenever we have 5 global folds and 3 total repeats
num_features_list = length(single_dab_models) / 15
for (ind in 1:num_features_list) {
ind_max = length(single_dab_models) - (num_features_list - ind)
seq_ind = seq(from = ind,
to = ind_max,
by = num_features_list)
temp_model_list = single_dab_models[seq_ind]
sorted_model_list[[ind]] = temp_model_list
}
sublist_ind = 1
plot_list = list()
for (sublist in sorted_model_list) {
coef_p = get_cv_coefs(sublist, plot = T)
ggsave(filename = paste("lasso_fs_pair_subsets_", save_index, ".png"), plot = coef_p$coef_plot,
dpi = 600)
save_index = save_index + 1
}
}
}
coef_parser(all_models)
